@prefix triage: <urn:atm:triage:> .

triage:PhaseD a triage:Phase .

triage:d-1 a triage:Sprint ;
  triage:inPhase triage:PhaseD ;
  triage:order 1 ;
  triage:branch "sprint/d-1-dependency-compatibility" ;
  triage:criteria "docs/plans/phase-d/sprint-d-1-dependency-compatibility.md" .

triage:d-2 a triage:Sprint ;
  triage:inPhase triage:PhaseD ;
  triage:order 1 ;
  triage:branch "sprint/d-2-consumer-docs" ;
  triage:criteria "docs/plans/phase-d/sprint-d-2-consumer-docs.md" .

triage:d-3 a triage:Sprint ;
  triage:dependsOn triage:d-1, triage:d-2 ;
  triage:inPhase triage:PhaseD ;
  triage:order 2 ;
  triage:branch "sprint/d-3-release" ;
  triage:criteria "docs/plans/phase-d/sprint-d-3-release.md" .
