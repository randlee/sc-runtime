{
  "schema_version": 1,
  "project": {
    "name": "sc-runtime",
    "archive_prefix": "sc-runtime",
    "description": "Scaffolding framework: config, transport, command envelope, and daemon assembly crates plus a cargo-generate template",
    "homepage": "https://github.com/randlee/sc-runtime",
    "license": "MIT",
    "readme_dependency_crate": "sc-runtime",
    "workspace_toml": "Cargo.toml",
    "rust_toolchain": "1.94.1"
  },
  "release_targets": [
    {
      "target": "x86_64-unknown-linux-gnu",
      "os": "ubuntu-latest",
      "archive": "tar.gz"
    }
  ],
  "crates": [
    {
      "artifact": "sc-config",
      "package": "sc-config",
      "cargo_toml": "crates/sc-config/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 1,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 60,
      "verify_install": false
    },
    {
      "artifact": "sc-transport",
      "package": "sc-transport",
      "cargo_toml": "crates/sc-transport/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 2,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 60,
      "verify_install": false
    },
    {
      "artifact": "sc-command",
      "package": "sc-command",
      "cargo_toml": "crates/sc-command/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 3,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 60,
      "verify_install": false
    },
    {
      "artifact": "sc-runtime",
      "package": "sc-runtime",
      "cargo_toml": "crates/sc-runtime/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 4,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 60,
      "verify_install": false
    },
    {
      "artifact": "sc-cron",
      "package": "sc-cron",
      "cargo_toml": "crates/sc-cron/Cargo.toml",
      "required": true,
      "publish": true,
      "publish_order": 5,
      "preflight_check": "locked",
      "wait_after_publish_seconds": 0,
      "verify_install": false
    }
  ],
  "release_binaries": [],
  "python_packages": [],
  "python_distributions": [],
  "npm_packages": [],
  "channels": {},
  "preflight_checks": [
    {
      "id": "observability-registry-only",
      "description": "Require the registry 1.5.0 bridge profile, reject local substitutes, and enforce upstream capability cleanup.",
      "run": "python3 scripts/check_observability_release.py"
    },
    {
      "id": "release-contract-sources",
      "description": "Verify prepublication release-generation source contracts.",
      "run": "bash scripts/check_release_contract_sources.sh"
    },
    {
      "id": "benchmark-pass",
      "description": "Monty benchmark gate on the controlled host (scripts/benchmark/check_gate.py).",
      "run": "python3 scripts/benchmark/run_remote_gate.py"
    }
  ]
}
