set windows-shell := ["cmd.exe", "/c"]

python := if os_family() == "windows" { "python" } else { "python3" }

# sc-lint managed recipes: default, setup, lint, test, upgrade.
# Consumer-owned recipes, kept across `sc-lint init --just`: db-prepare,
# build-cli, build-daemon.

default: lint

setup:
    {% raw %}{{python}}{% endraw %} .sc-lint/bootstrap.py setup --config sc-lint.toml

lint *profile:
    {% raw %}{{python}}{% endraw %} .sc-lint/bootstrap.py lint --config sc-lint.toml {% raw %}{{profile}}{% endraw %}

test *layer:
    {% raw %}{{python}}{% endraw %} .sc-lint/bootstrap.py test --config sc-lint.toml {% raw %}{{layer}}{% endraw %}
    {% raw %}{{python}}{% endraw %} scripts/consumer_checks.py observability
    {% raw %}{{python}}{% endraw %} scripts/consumer_checks.py store-boundaries

upgrade:
    {% raw %}{{python}}{% endraw %} .sc-lint/bootstrap.py upgrade --config sc-lint.toml

# Consumer-owned. A later `sc-lint init --just` must keep these recipes.
db-prepare:
    {% raw %}{{python}}{% endraw %} scripts/consumer_checks.py db-prepare

build-cli:
    cargo build -p {{project-name}}-cli --release
    cargo tree -p {{project-name}}-cli -e normal --prefix none
    {% raw %}{{python}}{% endraw %} scripts/consumer_checks.py build-cli

build-daemon:
    cargo build -p {{project-name}}-daemon --release
    cargo tree -p {{project-name}}-daemon -e normal --prefix none
    {% raw %}{{python}}{% endraw %} scripts/consumer_checks.py build-daemon
