# Managed by sc-lint; regenerate with `sc-lint init --just`.
set windows-shell := ["cmd.exe", "/c"]

python := if os_family() == "windows" { "python" } else { "python3" }

# The `full` profile runs boundary, line-counts, fmt, clippy
# (`-D warnings` and `-D clippy::await_holding_lock`), sc-portability,
# sc-runtime, function-length, identity-literals, compatibility, the
# ADR-RUN-0011 scanner, and the Windows cross-check.
#
# The cross-check is workspace-scoped. Crates that do not cross-compile yet
# are `--exclude`d. This sprint excludes `sc-runtime-db-sqlite`.
default:
    {{python}} .sc-lint/bootstrap.py lint full --config sc-lint.toml

setup:
    {{python}} .sc-lint/bootstrap.py setup --config sc-lint.toml

lint *profile:
    {{python}} .sc-lint/bootstrap.py lint --config sc-lint.toml {{profile}}
    just supply-chain

test *layer:
    {{ if layer == "generated-workspace" { "bash -eu -c 'cd \"$SC_RUNTIME_GENERATED_DIR\"; cargo check --workspace'" } else if layer == "generated-general-db-off" { "bash -eu -c 'cd \"$SC_RUNTIME_GENERATED_DIR\"; cargo test -p widget-app-cli --no-default-features --lib general_db_off_omits_delete_commands; cargo test -p widget-app-daemon --no-default-features --lib openapi_paths_omit_general_delete; cargo test -p widget-app-cli --no-default-features --test widget_mcp'" } else if layer == "lifecycle-signal" { python + " scripts/run_lifecycle_signal_test.py" } else if layer == "windows-hook-default" { "cargo +1.94.1 test -p sc-cron --test hook_environment" } else if layer == "windows-hook-monty" { "cargo +1.96.1 test -p sc-cron --features monty --test hook_environment" } else if layer == "windows-host-monty" { "cargo +1.96.1 test -p sc-cron --features monty --test monty_host_bridge" } else if layer == "development-bridge" { "bash -eu -c 'for manifest in dev/observability-types-shim/Cargo.toml dev/observability-logger-adapter/Cargo.toml; do cargo fmt --manifest-path \"$manifest\" --all -- --check; cargo test --manifest-path \"$manifest\" --all-features; cargo clippy --manifest-path \"$manifest\" --all-targets --all-features -- -D warnings; done'" } else { python + " .sc-lint/bootstrap.py test --config sc-lint.toml " + layer } }}

upgrade:
    {{python}} .sc-lint/bootstrap.py upgrade --config sc-lint.toml

# Repo-specific (not regenerated by sc-lint init).

# ADR-RUN-0011 point 1 until sc-lint#640. The full profile step `adr-run-0011`
# runs this recipe. `{{python}}` is python3 on Unix and python on Windows.
# A match outside a cfg that requires `test`, and outside a same-line `allow:`
# comment, fails. `#[cfg(all(test, feature = "test-util"))] mod tests;` exempts
# the included file.
adr-run-0011:
    {{python}} scripts/adr_run_0011_grep.py

# License, advisory, and duplicate checks. `just lint` always runs this.
supply-chain:
    cargo deny check
    cargo audit

test-generation:
    {{python}} scripts/run_generation_tests.py

new dest *args:
    {{python}} scripts/new_project.py {{dest}} {{args}}
