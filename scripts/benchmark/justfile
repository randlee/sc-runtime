# Benchmark campaigns (sprint b-11).
# Invoke from repo root: just --justfile scripts/benchmark/justfile <recipe>
# See .claude/skills/benchmark-run/SKILL.md. Default CI does not run these.

set windows-shell := ["cmd.exe", "/c"]

python := if os_family() == "windows" { "python" } else { "python3" }

benchmark subsystem:
    {{python}} scripts/benchmark/{{subsystem}}/campaign.py

benchmark-show subsystem:
    {{python}} scripts/benchmark/{{subsystem}}/campaign.py --show

benchmark-publish subsystem:
    {{python}} scripts/benchmark/{{subsystem}}/campaign.py --publish

benchmark-gate:
    {{python}} scripts/benchmark/check_gate.py

# Backward-compatible Monty recipe names.
benchmark-monty:
    {{python}} scripts/benchmark/monty/campaign.py

benchmark-monty-show:
    {{python}} scripts/benchmark/monty/campaign.py --show

benchmark-monty-publish:
    {{python}} scripts/benchmark/monty/campaign.py --publish
