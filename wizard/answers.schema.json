{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/randlee/sc-runtime/wizard/answers.schema.json",
  "title": "Generation answers",
  "type": "object",
  "additionalProperties": false,
  "x-schema-version": 2,
  "required": ["project_name", "db", "mcp"],
  "properties": {
    "project_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "x-role": "project-name"
    },
    "db": {
      "type": "string",
      "enum": ["none", "sqlite", "postgres", "mysql", "sqlite-postgres", "sqlite-mysql"],
      "default": "sqlite",
      "x-role": "database"
    },
    "mcp": {
      "type": "boolean",
      "default": true
    },
    "licence": {
      "type": "string",
      "minLength": 1,
      "default": "MIT"
    }
  }
}
