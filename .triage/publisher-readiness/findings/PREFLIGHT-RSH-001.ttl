<urn:sc-runtime:publisher-readiness:PREFLIGHT-RSH-001> qa:id "PREFLIGHT-RSH-001" ; qa:severity "blocking" ; qa:status "open" ; qa:reviewCommit "e47b7ccdc955377a4f54061967b3c02a79bc4e3a" ; qa:summary "emit_reports prints the retained-evidence path with flush=True before copying campaign JSON/HTML into that retained directory. If stdout is closed, BrokenPipeError prevents the copies; temporary-checkout cleanup then removes the only campaign. The bounded probe reproduced zero retained files." ; qa:aliases "PREFLIGHT-REQ-001,PREFLIGHT-FTQ-001" ; qa:ownerSeverity "Important" .
