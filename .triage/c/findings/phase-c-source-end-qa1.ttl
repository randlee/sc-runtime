qa:REQ-QA-PHASE-C-END-001 qa:id "REQ-QA-PHASE-C-END-001" ;
  qa:severity "Blocking" ;
  qa:reviewer "req-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"category\": \"cross-doc-conflict\", \"compliance_result\": \"non-compliant\", \"id\": \"REQ-QA-PHASE-C-END-001\", \"issue\": \"The binding template-CI requirement says every answers fixture must be generated and run through the standard recipes on every pull request. The workflow instead emits a successful docs-only skip and bypasses checkout, generation and recipes whenever requires_runtime is false. A docs-only path such as docs/requirements.md falls outside the classifier runtime prefixes/files. No requirements, architecture or quality-policy exception authorizing this behavior was found. The branch executes runtime CI for current code changes, but that does not make the configured every-PR contract compliant.\", \"preexisting\": true, \"provenance\": \"Classifier introduced by9d1a34091565005103f78eb9aab0f59dd5f1a21f; its commit message describes observability bridging and grants no explicit every-PR exception.\", \"required_correction\": \"Align implementation with the binding every-PR fixture execution contract. If a docs-only exception is intended, obtain its required governing authority and amend the authoritative requirement through the reviewed plan; do not infer a waiver from the existing classifier or green skipped checks. Preserve the actual no-edits/profile and release-mode proofs.\", \"reviewer\": \"req-qa\", \"severity\": \"Blocking\", \"source_refs\": [\"docs/requirements.md:3578\", \"docs/requirements.md:3584\", \"docs/requirements.md:3622\", \"docs/requirements.md:3666\"], \"stage\": \"A/source implementation contract\", \"target_refs\": [\".github/workflows/template.yml:69\", \".github/workflows/template.yml:119\", \".github/workflows/template.yml:127\", \".github/scripts/ci_scope.py:37\"]}" .

qa:REQ-QA-C4-006 qa:id "REQ-QA-C4-006" ;
  qa:severity "Blocking" ;
  qa:reviewer "req-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"category\": \"acceptance-gap\", \"compliance_result\": \"partially-compliant\", \"correlated_ids\": [\"ARCH-003\"], \"id\": \"REQ-QA-C4-006\", \"issue\": \"Prepublication source qualification is not complete: current controlled-host, source-equivalent benchmark evidence is absent; supplied source-bound readiness says NOT_QUIET and no campaign started. Final prerequisite ordered QA/CI/merge and C4 applicable live-anchor/current CI gates are not established as complete in this packet. The exact current root lint/test execution gap is now closed by inspected actual receipts; it must not be repeated as still missing.\", \"required_correction\": \"Complete remaining actual source qualification and normal prerequisite promotion, execute the governed campaign on the controlled host when its existing readiness conditions hold, verify measured-source equivalence and applicable live-anchor/current CI gates. Keep full publication and registry acceptance pending until their separate real stages. No source defect, new benchmark policy or additional process artifact is requested.\", \"reviewer\": \"req-qa\", \"severity\": \"Blocking\", \"source_refs\": [\"docs/plans/phase-c/sprint-c-4-runtime-ecosystem-release.md:128\", \"docs/plans/phase-c/sprint-c-4-runtime-ecosystem-release.md:148\", \"docs/architecture.md:2776\"], \"stage\": \"A/source qualification\", \"target_refs\": [\"scripts/benchmark/check_release_evidence.py\", \"/tmp/sc-runtime-phase-c-execution/pr122-benchmark-stage-prep/f5ecdb9/receipt.json\"]}" .

qa:ARCH-PHASE-C-001 qa:id "ARCH-PHASE-C-001" ;
  qa:severity "BLOCKING" ;
  qa:reviewer "arch-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"adr\": null, \"description\": \"C3 declares ownership of crates/sc-config/Cargo.toml and crates/sc-transport/Cargo.toml at lines108–109, but its adrs list omits all nine binding ADRs for those owned crates. RULE-ADR-PLAN requires every ADR of each owned crate, including manifest ownership. All other listed IDs resolve, and no implementation violation of these nine ADRs was found.\", \"evidence_refs\": [\".claude/agents/arch-qa.md:94\", \"docs/plans/phase-c/sprint-c-3-runtime-ecosystem-upgrade.md:71\", \"docs/plans/phase-c/sprint-c-3-runtime-ecosystem-upgrade.md:108\", \"docs/plans/phase-c/sprint-c-3-runtime-ecosystem-upgrade.md:109\", \"docs/sc-config/architecture.md:50\", \"docs/sc-transport/architecture.md:39\"], \"file\": \"docs/plans/phase-c/sprint-c-3-runtime-ecosystem-upgrade.md\", \"id\": \"ARCH-PHASE-C-001\", \"line\": 71, \"missing_adr_ids\": [\"ADR-CFG-0001\", \"ADR-CFG-0002\", \"ADR-CFG-0003\", \"ADR-TRN-0001\", \"ADR-TRN-0002\", \"ADR-TRN-0003\", \"ADR-TRN-0004\", \"ADR-TRN-0005\", \"ADR-TRN-0006\"], \"remediation\": \"Add ADR-CFG-0001, ADR-CFG-0002, ADR-CFG-0003 and ADR-TRN-0001 through ADR-TRN-0006 to C3's single adrs list, preserving existing ownership and source. Recheck exact binding-reference resolution; no new ADR or code mechanism is needed.\", \"reviewer\": \"arch-qa\", \"rule\": \"RULE-ADR-PLAN\", \"severity\": \"BLOCKING\"}" .

qa:ARCH-003 qa:id "ARCH-003" ;
  qa:severity "BLOCKING" ;
  qa:reviewer "arch-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"adr\": \"ADR-RUN-0015\", \"description\": \"The required Stage A controlled-host measured-source gate remains open at this source. Direct comparison of all11 committed campaigns finds non-report tracked differences against f5ecdb9; none can qualify this composed source under the unchanged verifier. Actual host readiness receipt says NOT_QUIET and no campaign was run. Root lint/test now genuinely pass, but they do not replace controlled measurement.\", \"evidence_refs\": [\"docs/architecture.md:2765\", \"docs/development/sc-publish.md:137\", \"scripts/benchmark/check_release_evidence.py:35\", \"scripts/benchmark/check_release_evidence.py:155\", \"docs/plans/phase-c/sprint-c-4-runtime-ecosystem-release.md:154\", \"/tmp/sc-runtime-phase-c-execution/phase-c-source-end-qa1/arch-qa-benchmark-comparison.json\", \"/tmp/sc-runtime-phase-c-execution/pr122-benchmark-stage-prep/f5ecdb9/receipt.json\"], \"file\": \"docs/plans/phase-c/sprint-c-4-runtime-ecosystem-release.md\", \"id\": \"ARCH-003\", \"line\": 154, \"remediation\": \"After the final tracked source is settled, execute the governed campaign on a quiet qualified controlled host, commit only canonical campaign outputs/index updates, and independently review measured-source equality and actual result. Preserve MEASURED semantics for null floors. Do not relabel old measurements, relax equivalence or require postpublication registry execution before initial source promotion.\", \"reviewer\": \"arch-qa\", \"rule\": \"RULE-GATE\", \"severity\": \"BLOCKING\"}" .

qa:RBQA-PHASE-C-END-001 qa:id "RBQA-PHASE-C-END-001" ;
  qa:severity "important" ;
  qa:reviewer "ruthless-boundary-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"class\": \"lint_gap\", \"evidence\": \"REQ-RUN-0005 adapter row (docs/requirements.md:488) forbids production tool crates and full observability/OTLP. The same requirement explains that workspace-only sc-lint cannot inspect external/transitive edges. tests/unit/test_production_tool_boundary.py:20-23 lists five SDKs only; scan iterates RELEASE and check_trees iterates FEATURES. scripts/check_observability_dependencies.py:19 lists the same five owners, and main iterates only OWNERS. Existing generated CLI graph checks reject some heavy package names but not the complete sc-compose/ATM identity families, OTLP/development adapter, or the isolated scheduler-enabled adapter graph. The actual current root lint log truthfully reports PASS for five SDKs, not six. Current sc-cron-commands manifest contains no forbidden package; this finding is missing enforcement, not an asserted active leak.\", \"file\": \"tests/unit/test_production_tool_boundary.py\", \"id\": \"RBQA-PHASE-C-END-001\", \"issue\": \"The sixth public SDK, sc-cron-commands, is omitted from the existing production-tool and observability dependency-boundary owner sets. Its external/transitive production tool, full-logger and OTLP exclusions therefore lack the mandatory companion enforcement applied to the other SDKs.\", \"justification_check\": \"Existing mandatory boundary guard must cover the new public owner; no separate enforcement mechanism is justified.\", \"line\": 20, \"recommendation\": \"Extend the existing production-tool RELEASE/FEATURES coverage and observability OWNERS coverage to sc-cron-commands and its supported production feature combinations. Add causal negative cases for an aliased/direct or transitive forbidden adapter dependency and retain the dev-only allowance. Reuse the existing guards; no new lint framework or process artifact is needed.\", \"related_artifacts\": [\"docs/requirements.md\", \"boundaries/sc-cron-commands/sc-cron-commands.toml\", \"crates/sc-cron-commands/Cargo.toml\", \"tests/unit/test_production_tool_boundary.py\", \"scripts/check_observability_dependencies.py\", \"scripts/tests/test_observability_dependencies.py\"], \"reviewer\": \"ruthless-boundary-qa\", \"severity\": \"important\"}" .

qa:RBQA-PHASE-C-END-002 qa:id "RBQA-PHASE-C-END-002" ;
  qa:severity "minor" ;
  qa:reviewer "ruthless-boundary-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"class\": \"doc_gap\", \"evidence\": \"REQ-RUN-0005 criterion2 requires each boundary manifest to record the items its crate exports. crates/sc-command/src/lib.rs publicly re-exports OpError/ErrorKind, server IntoMcp/McpError and three public constants, while boundaries/sc-command/sc-command.toml:7 lists only Envelope,observability. boundaries/README.md explicitly documents that sc-lint parses the list but does not compare it with pub use. This is a pre-existing inventory discrepancy within the full phase-end review scope; it is not an active dependency leak or a new API requirement.\", \"file\": \"boundaries/sc-command/sc-command.toml\", \"id\": \"RBQA-PHASE-C-END-002\", \"issue\": \"The command boundary public-facade inventory names only Envelope and observability, omitting the root-exported canonical error types, server conversions and wire constants.\", \"justification_check\": \"Required existing facade inventory is incomplete; correcting it preserves the existing public contract.\", \"line\": 7, \"recommendation\": \"Correct the existing public.facade list to include OpError, ErrorKind, feature-gated IntoMcp/McpError and the exported ENVELOPE_VERSION, DISCRIMINANT_CODE and SERIALIZATION_CODE constants, with feature notes as appropriate. Do not add a new snapshot or framework.\", \"related_artifacts\": [\"docs/requirements.md\", \"crates/sc-command/src/lib.rs\", \"boundaries/sc-command/sc-command.toml\", \"boundaries/README.md\"], \"reviewer\": \"ruthless-boundary-qa\", \"severity\": \"minor\"}" .

qa:RSH-001 qa:id "RSH-001" ;
  qa:severity "important" ;
  qa:reviewer "rust-service-hardening-agent" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"evidence\": \"Cron routing lib.rs:372-383 -> post_widget:667-673 -> sc_transport Client::new/post. Transport client.rs:12-15,158-160 fixes request timeout at2s. TransportError::recovery error.rs:271-272 explicitly says Retry the call; Display:429 onward appends it. CLI lib.rs:460-465 directly emits that Display in human mode, while map_transport:351-359 supplies suggested_action only for DAEMON.NOT_RUNNING. Runtime router.rs:64 uses30s and operation.rs:342-370 retains native closure ownership independent of canceled transport waiters. Compatibility contract forbids blind replay of uncertain mutations and treats generation fencing as distinct from exactly-once identity. This is a source-call-chain finding, not an executed timeout test.\", \"file\": \"template/crates/cli/src/lib.rs\", \"id\": \"RSH-001\", \"issue\": \"Generated cron mutation commands advise blind replay after a transport timeout with unknown completion. The human-output branch emits error.to_string(), whose TimedOut recovery says \\\"Retry the call\\\". Client timeout is2 seconds, whereas the server has a30-second request scope and accepted native work remains physically owned after a waiter disappears; a timed-out cron.start/end may therefore still commit. JSON mode omits any reconciliation action for this error. Neither mode explains that completion is unknown.\", \"line\": 460, \"recommendation\": \"At the generated CLI transport-error projection, preserve the stable transport code/cause but return unknown-completion and separately authorized reconciliation guidance for uncertain mutating cron failures, in both human and JSON modes. Do not automatically replay, assert rollback, fabricate a native TransactionOutcome, increase deadlines or change physical ownership. Add deterministic projection coverage for timeout recovery in both modes.\", \"reviewer\": \"rust-service-hardening-agent\", \"severity\": \"important\", \"topic\": \"retries\"}" .

qa:FTQ-PHASE-C-001 qa:id "FTQ-PHASE-C-001" ;
  qa:severity "important" ;
  qa:reviewer "flaky-test-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"evidence\": \"Direct call at tests/unit/generation/test_cron_schema.py:100-118 has no timeout/owner. scripts/run_generation_tests.py:43 invokes unittest.TextTestRunner directly. tests/integration/generation/generate_owned.py:13-25 already provides the bounded whole-command/tree boundary. The unsafe caller body predates this phase but its file is changed in the requested full Phase C audit.\", \"file\": \"tests/unit/generation/test_cron_schema.py\", \"id\": \"FTQ-PHASE-C-001\", \"issue\": \"The remaining real schema-generation test calls cargo generate with --allow-commands using subprocess.run(capture_output=True) without a deadline or owned process-tree boundary. A stalled generator/template hook or descendant retaining a captured pipe leaves canonical direct unittest blocked indefinitely; TemporaryDirectory cannot clean up while the call waits.\", \"line\": 100, \"mechanism\": \"unbounded_wait\", \"recommendation\": \"Route the unchanged real Cargo invocation through the existing generate_owned.run_generation (or canonical cargo_generate helper), retaining all schema/default/exclusion assertions and the existing standard generation budget. Preserve causal failure/stall cleanup witnesses; do not add retries, skips, padded deadlines or a whole-suite wrapper.\", \"reviewer\": \"flaky-test-qa\", \"severity\": \"important\", \"test\": \"CronSchemaTests.test_generated_project_omits_the_cron_schema\"}" .

qa:FTQ-PHASE-C-002 qa:id "FTQ-PHASE-C-002" ;
  qa:severity "important" ;
  qa:reviewer "flaky-test-qa" ;
  qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
  qa:status "open" ;
  qa:recordedBeforeFix true ;
  qa:findingJson "{\"evidence\": \"crates/sc-runtime-db-sqlite/tests/sqlx_resolve.rs:11-20 directly invokes Command::output without timeout or supervision. Unlike the cooperative/consumer tests, this function has no supervised self-child guard. --locked freezes resolution but supplies no time bound and does not disable network or lock waits. The file is modified by Phase C resolver version assertions.\", \"file\": \"crates/sc-runtime-db-sqlite/tests/sqlx_resolve.rs\", \"id\": \"FTQ-PHASE-C-002\", \"issue\": \"The real resolver regression launches cargo metadata --locked with std::process::Command::output and no deadline or owned subprocess boundary. Cargo can wait on a package/cache lock or stalled dependency fetch; output also waits for pipe EOF. Neither this test nor a supervising re-executed test process imposes a hard deadline, so the workspace test can hang instead of fail.\", \"line\": 11, \"mechanism\": \"unbounded_wait\", \"recommendation\": \"Execute this exact locked resolver probe within an existing portable bounded process-tree owner, preserving the real metadata assertions and normal SQLite identity check. Use a bounded owned command/test venue with physical cleanup on timeout/failure; do not replace the real probe with string checks, increase deadlines, retry or skip it.\", \"reviewer\": \"flaky-test-qa\", \"severity\": \"important\", \"test\": \"rusqlite_0_39_resolves_one_libsqlite3_sys_with_sqlx_0_9_sqlite\"}" .

