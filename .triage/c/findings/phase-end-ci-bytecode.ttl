qa:CI-C4-BYTECODE-001 qa:id "CI-C4-BYTECODE-001" ;
 qa:severity "important" ;
 qa:sourceCommit "f5ecdb987b4c80d3e6e1d1afb0985dd109177443" ;
 qa:status "open" ;
 qa:recordedBeforeFix true ;
 qa:findingJson "{\"evidence\": \"Current f5 CI root job127791717471 failed one of195 generation tests: scripts/__pycache__/dependency_policy.cpython-314.pyc differs. Independently read actual two-destination proof files: both helper sources equal pinned f5 source SHA8f73c904..., their .pyc SHA256 values differ, and each contains its own recorded absolute filename. Verified supplied raw CI log hash and the local full-root receipt environment PYTHONDONTWRITEBYTECODE=1. No reviewer test execution or live CI query.\", \"file\": \"template/scripts/consumer_checks.py\", \"id\": \"CI-C4-BYTECODE-001\", \"issue\": \"The production consumer checker imports dependency_policy with ordinary bytecode writing enabled. Generated wizard and var-file destinations acquire .pyc files containing their different absolute code.co_filename paths, so the existing byte-for-byte tree-equivalence test fails in normal CI. The earlier local root PASS depended on ambient PYTHONDONTWRITEBYTECODE=1, masking the ordinary default consumer artifact; test outcome therefore depends on that environment setting.\", \"line\": 152, \"mechanism\": \"env_leak\", \"recommendation\": \"Suppress bytecode only while importing this local helper and restore the previous interpreter setting. Add a bounded real two-destination regression with PYTHONDONTWRITEBYTECODE absent and bytecode explicitly enabled, then requalify the existing real wizard/var-file pipeline unchanged. Do not filter __pycache__ from the comparison, impose a CI environment mask, retry or weaken assertions.\", \"reviewer\": \"flaky-test-qa\", \"severity\": \"important\", \"source_commit\": \"f5ecdb987b4c80d3e6e1d1afb0985dd109177443\", \"test\": \"OutputEquivalenceTests.test_stubbed_wizard_matches_var_file_tree\"}" .
