 triage:reviewed_commit "e4f01c5d160be7025ad1a6e22dd97676940b1be1" ;
 triage:file "examples/spike/phase-c-contract/probe.py" ;
 triage:issue "Retained executable qualification probes run captured subprocesses without deadlines or process-tree ownership, so manual qualification can hang forever on a command or inherited pipe writer. Being outside CI does not supply bounded ownership." ;
