 qa:findingJson "{\"category\": \"acceptance-gap\", \"compliance_result\": \"partially-compliant\", \"id\": \"CI-C5-C6-FIXTURE-VERSION-001\", \"issue\": \"Both normal and dev dependencies in the isolated public logging fixture require sc-cron0.1.1 while the actual path package is0.2.0. Current exact-source root CI terminates with Cargo metadata101 in test_isolated_cron_logging_consumer before its graph/facade assertions. The earlier scoped consumer commands used a different external fixture and cannot close this failing required validation path.\", \"required_correction\": \"Adopt the already implemented canonical C4 two-line fixture correction: change only both sc-cron version requirements to0.2.0, retaining isolation, paths, features and assertions. Run all14 observability-dependency tests and requalify current-head CI; no Cargo retry, offline removal, resolver relaxation, skip or deadline change.\", \"severity\": \"Important\", \"source_refs\": [\"docs/plans/phase-c/sprint-c-5-cron-consumer-compatibility.md:80\", \"docs/plans/phase-c/sprint-c-5-cron-consumer-compatibility.md:182\", \"docs/sc-cron/requirements.md:238\"], \"target_refs\": [\"crates/sc-cron/tests/fixtures/logging_consumer/Cargo.toml:11\", \"crates/sc-cron/tests/fixtures/logging_consumer/Cargo.toml:14\", \"crates/sc-cron/Cargo.toml:4\", \"scripts/tests/test_observability_dependencies.py:34\", \"https://github.com/randlee/sc-runtime/actions/runs/42187254942/job/127791151984\"]}" .
