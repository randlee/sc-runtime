 triage:reviewed_commit "b72712ff3a060e97a8229e48f0b29c6536020e54" ;
 triage:file "template/crates/daemon/src/observability_adapter_tests.rs:127; template/crates/daemon/src/observability_adapter_tests.rs:169" ;
 triage:issue "A changed generated logger fixture still performs unbounded physical child waits in Drop and timeout cleanup, so it can hang despite successful current executions." ;
