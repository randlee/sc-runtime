 triage:id "ARCH-C5-005" ;
 triage:severity "BLOCKING" ;
 triage:reviewer "arch-qa" ;
 triage:status "fixed" ;
 triage:reviewed_commit "f7d58b1c8556b55fcff744cfa3e3c5775521b795" ;
 triage:file "crates/sc-command/src/envelope.rs" ;
 triage:issue "The full PR diff introduces reachable expect calls in public sc-command schema trait implementations. ADR-RUN-0006 point3 explicitly prohibits reachable expect in public functions and permits no invariant-comment exception; ADR-RUN-0017 only records the separate fixed-Noop exception. The same pattern appears in both Schemars and Utoipa canonical error schema implementations. Static generated JSON does not create an approved exception." ;
 triage:action "Have the schema owner replace the conversions with infallible native schema construction while preserving the exact wire/schema meaning, then merge forward. Do not add a panic-policy waiver or change public trait signatures." ;
 triage:fix_disposition "Owner schemas construct native infallible Schemars maps and Utoipa builders; real typed path macro regression and exact wire tests; no panic-policy exception." ;
 triage:verification_source "https://github.com/randlee/sc-runtime/pull/118#issuecomment-6647574110" .

