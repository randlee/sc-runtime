 triage:file "tests/unit/generation/test_monty_example.py" ;
 triage:issue "Correlated existing requirement-review finding: the new planted-lock regression calls generation.cargo_generate in-process. Its external version, generation and formatting commands lack deadlines and owned descendant cleanup; a stalled command or inherited captured-pipe writer can hang this unittest indefinitely." ;
 triage:action "Keep the planted stale-lock fixture and absence assertion; run generation through the existing bounded owned-process boundary with physical descendant cleanup and regular-file capture. Add a causal stalled-generation negative. No retries, skips, padding, serialization or broad product-driver rewrite." ;
 triage:verification_source "https://github.com/randlee/sc-runtime/pull/118#issuecomment-6676408599" .
